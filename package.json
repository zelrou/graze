{
  "name": "Graze Web Extension",
  "description": "manifest.json description",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "test": "vitest --ui",
    "test:dev": "vitest --ui --inspect-brk --isolate=false --no-file-parallelism",
    "e2e": "playwright test --ui --workers=1",
    "e2e:dev": "playwright test --ui --debug --workers=1",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.3.0",
    "isomorphic-dompurify": "^2.34.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "@wxt-dev/module-react": "^1.1.5",
    "jsdom": "^27.3.0",
    "jsdom-devtools-formatter": "^1.0.1",
    "playwright": "^1.57.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15",
    "vitest-browser-react": "^2.0.2",
    "wxt": "^0.20.11"
  }
}